#!/bin/bash
# tmux-sessionizer — fuzzy-find a directory and attach/create a tmux session for it.
# Default search paths can be overridden with TMUX_SESSIONIZER_DIRS.

set -euo pipefail

DIRS="${TMUX_SESSIONIZER_DIRS:-$HOME/.dotfiles $HOME/projects $HOME/work}"

if [[ $# -eq 1 ]]; then
  selected="$1"
else
  selected=$(find $DIRS -mindepth 1 -maxdepth 2 -type d 2>/dev/null | sort -u | fzf --prompt='session> ')
fi

if [[ -z "$selected" ]]; then
  exit 0
fi

selected_name=$(basename "$selected" | tr '. ' '__')
tmux_running=$(pgrep -x tmux || true)

if [[ -z "${TMUX:-}" ]]; then
  tmux new-session -s "$selected_name" -c "$selected" -A
else
  if ! tmux has-session -t="$selected_name" 2>/dev/null; then
    tmux new-session -ds "$selected_name" -c "$selected"
  fi
  tmux switch-client -t "$selected_name"
fi
