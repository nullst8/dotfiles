{
  "layer": "top",
  "position": "top",
  "spacing": 4,
  "margin-top": 0,
  "margin-bottom": 0,


  "modules-left": ["hyprland/workspaces"],

  "modules-center": ["clock"],

  "modules-right": [
    "custom/volume",
    "custom/cpu",
    "memory",
    "custom/brightness",
    "custom/battery",
    "custom/notification",
    "custom/nightlight",
    "tray"
  ],

  "tray": {
    "icon-size": 20,
    "spacing": 10
  },

  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%H:%M}",
    "format-alt": "{:%A, %B %d}",
    "interval": 60
  },

  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/cpu.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 3,
    "on-click": "~/.dotfiles/scripts/perf-mode.sh popup"
  },

  "memory": {
    "format": "{}% RAM",
    "interval": 10
  },

  "custom/brightness": {
    "exec": "~/.config/waybar/scripts/brightness.sh",
    "format": "{}",
    "interval": 1,
    "tooltip": true,
    "return-type": "json"
  },

  "custom/nightlight": {
    "exec": "~/.config/waybar/scripts/nightlight.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 60,
    "on-click": "~/.dotfiles/scripts/nightlight.sh toggle"
  },

  "custom/battery": {
    "exec": "~/.config/waybar/scripts/battery.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 30,
    "on-click": "~/.dotfiles/scripts/bat-threshold.sh popup"
  },

  "custom/volume": {
    "exec": "~/.config/waybar/scripts/volume.sh",
    "return-type": "json",
    "tooltip": true,
    "interval": 1,
    "on-click": "pavucontrol",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 1%+",
    "on-scroll-down": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 1%-"
  },

  "custom/notification": {
    "exec": "swaync-client -c",
    "on-click": "swaync-client -t",
    "return-type": "number",
    "format": " {}",
    "interval": 30,
    "tooltip": false,
    "signal": 8
  }
}
